# ══════════════════════════════════════════════════════════════════
# Ascend App — Environment Variables
# Copy this file's structure to Vercel Dashboard → Project Settings → Environment Variables
# For local dev: copy to .env.local (gitignored) and fill in values
# ══════════════════════════════════════════════════════════════════

# ── Vercel KV (Redis) ─────────────────────────────────────────────
# 1. Go to vercel.com/dashboard → your project → Storage tab
# 2. Create a KV store (free tier available)
# 3. Open the store → .env.local tab → copy both values
KV_REST_API_URL=https://your-kv-name.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# ── JWT Secret ────────────────────────────────────────────────────
# Used to sign session cookies and magic link tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be the same value in both local .env.local and Vercel dashboard.
JWT_SECRET=your_128_char_hex_jwt_secret_here

# ── Encryption Secret ─────────────────────────────────────────────
# Used to encrypt user objects stored in KV at rest (AES-256-GCM).
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Never rotate this without migrating all KV data first.
ENCRYPTION_SECRET=your_64_char_hex_encryption_secret_here

# ── Resend (Magic Link Email) ─────────────────────────────────────
# 1. Create account at resend.com (free tier: 100 emails/day)
# 2. Go to API Keys → Create API Key → copy here
# 3. Go to Domains → Add Domain → verify ascend-app-one.vercel.app
#    Until domain is verified, use sandbox: set RESEND_FROM_DOMAIN=resend.dev
RESEND_API_KEY=re_your_resend_api_key_here

# ── Sending Domain ────────────────────────────────────────────────
# Set to your verified domain once DNS is configured in Resend.
# Use "resend.dev" for development/testing (Resend sandbox).
RESEND_FROM_DOMAIN=resend.dev

# ── App URL ───────────────────────────────────────────────────────
# Used to build the magic link URL in send-link.js
# Production: https://ascend-app-one.vercel.app
# Local dev:  http://localhost:5173
APP_URL=https://ascend-app-one.vercel.app

# ══════════════════════════════════════════════════════════════════
# COMING LATER — Agent 2 (Calendar Integrations)
# ══════════════════════════════════════════════════════════════════

# ── Google Calendar OAuth ─────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create/select project
# 2. APIs & Services → Enable → Google Calendar API
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#    Application type: Web application
#    Authorized redirect URI: https://ascend-app-one.vercel.app/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ascend-app-one.vercel.app/api/integrations/google/callback

# ── Microsoft / Outlook OAuth ─────────────────────────────────────
# 1. Go to portal.azure.com → Azure Active Directory → App registrations
# 2. New registration → name "Ascend" → Accounts in any org directory + personal
# 3. Authentication → Add platform → Web → Redirect URI: see below
# 4. Certificates & secrets → New client secret → copy value (not ID)
# 5. API permissions → Add → Microsoft Graph → Delegated → Calendars.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://ascend-app-one.vercel.app/api/integrations/outlook/callback

# ══════════════════════════════════════════════════════════════════
# COMING LATER — Agent 4 (AI Email Drafter)
# ══════════════════════════════════════════════════════════════════

# ── Anthropic API ─────────────────────────────────────────────────
# 1. Go to console.anthropic.com
# 2. API Keys → Create Key → copy here
ANTHROPIC_API_KEY=
