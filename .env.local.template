# ══════════════════════════════════════════════════════════════════
# ASCEND LOCAL CREDENTIALS — PERSONAL COPY
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — NEVER commit secrets to the repo.
# Keep this template file updated as new vars are added.
# ══════════════════════════════════════════════════════════════════

# ── Vercel KV ─────────────────────────────────────────────────────
# vercel.com/dashboard → [your project] → Storage tab → open your KV store → .env.local tab
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── JWT Secret ────────────────────────────────────────────────────
# Generate a fresh one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Paste the same value into Vercel dashboard env vars (for production).
JWT_SECRET=

# ── Encryption Secret ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex chars. Paste same value into Vercel dashboard.
# Rotating this value will invalidate all existing user data in KV.
ENCRYPTION_SECRET=

# ── Resend ────────────────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=

# Set to "resend.dev" until you've verified your domain in Resend dashboard.
# Once ascend-app-one.vercel.app is verified, set to: ascend-app-one.vercel.app
RESEND_FROM_DOMAIN=resend.dev

# ── App URL ───────────────────────────────────────────────────────
# Use localhost for local dev so magic links work without deploying
APP_URL=http://localhost:5173

# ══════════════════════════════════════════════════════════════════
# Add Google / Microsoft / Anthropic keys here when you set them up
# (see .env.example for setup instructions for each)
# ══════════════════════════════════════════════════════════════════
